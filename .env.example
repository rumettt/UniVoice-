# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=univoice_database
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_POOL_MAX=10

# Authentication & Tokens
# Generate strong, random secrets in production (e.g. openssl rand -base64 32)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_16_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_16_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# File Storage
# Local filesystem storage directory (relative or absolute path)
STORAGE_LOCAL_DIR=./uploads
# Max file size in bytes (default 10MB)
STORAGE_MAX_FILE_SIZE_BYTES=10485760
